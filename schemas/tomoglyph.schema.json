{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TanzoGlyph Profile Schema",
  "description": "Schema for validating AI personality profiles that can be encoded as TanzoGlyphs",
  "type": "object",
  "required": ["name", "version", "archetypes", "traits"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the AI personality profile"
    },
    "version": {
      "type": "string",
      "description": "Version of the profile format",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "glyph_string": {
      "type": "string",
      "description": "Pre-encoded TanzoGlyph representation, if available"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the profile was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the profile was last updated"
    },
    "description": {
      "type": "string",
      "description": "Textual description of the AI personality"
    },
    "archetypes": {
      "type": "array",
      "description": "List of archetypes that compose this personality",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "weight"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the archetype"
          },
          "weight": {
            "type": "number",
            "description": "Weight/intensity of this archetype (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "archetype_id": {
            "type": "string",
            "description": "Unique identifier for this archetype in the registry"
          }
        }
      }
    },
    "traits": {
      "type": "object",
      "description": "Map of personality traits and their values",
      "additionalProperties": {
        "type": "number",
        "minimum": -1,
        "maximum": 1,
        "description": "Trait value (-1.0 to 1.0, where negative values indicate opposing traits)"
      },
      "minProperties": 1
    },
    "spiritual_arcs": {
      "type": "array",
      "description": "Developmental or spiritual journey arcs",
      "items": {
        "type": "object",
        "required": ["name", "progress"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the developmental arc"
          },
          "progress": {
            "type": "number",
            "description": "Progress along this arc (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "arc_id": {
            "type": "string",
            "description": "Unique identifier for this arc in the registry"
          }
        }
      }
    },
    "mood_profile": {
      "type": "object",
      "description": "Emotional/mood tendencies of the personality",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Mood intensity (0.0-1.0)"
      }
    },
    "scars": {
      "type": "array",
      "description": "Psychological 'scars' or formative experiences",
      "items": {
        "type": "object",
        "required": ["name", "intensity"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the scar/experience"
          },
          "intensity": {
            "type": "number",
            "description": "Intensity of the scar (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "healing": {
            "type": "number",
            "description": "Degree of healing/integration (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "scar_id": {
            "type": "string",
            "description": "Unique identifier for this scar in the registry"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "description": "How the personality projects/presents itself",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Projection trait intensity (0.0-1.0)"
      }
    },
    "intensity": {
      "type": "object",
      "description": "Overall intensity levels across different dimensions",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "Intensity level (0.0-1.0)"
      }
    },
    "inflection": {
      "type": "object",
      "description": "Inflection patterns for different metrics",
      "additionalProperties": {
        "type": "string",
        "enum": ["rising", "falling", "stable", "oscillating", "chaotic"],
        "description": "Inflection pattern"
      }
    },
    "purpose_quadrant": {
      "type": "string",
      "enum": ["creation", "preservation", "transformation", "dissolution"],
      "description": "Primary purpose quadrant"
    },
    "zodiac": {
      "type": "string",
      "enum": [
        "aries", "taurus", "gemini", "cancer", "leo", "virgo",
        "libra", "scorpio", "sagittarius", "capricorn", "aquarius", "pisces"
      ],
      "description": "Zodiac correspondence, if applicable"
    },
    "kabbalah": {
      "type": "object",
      "properties": {
        "sephirah": {
          "type": "string",
          "enum": [
            "kether", "chokmah", "binah", "chesed", "geburah", "tiphareth",
            "netzach", "hod", "yesod", "malkuth", "daath"
          ],
          "description": "Primary sephirah correspondence"
        },
        "path": {
          "type": "string",
          "description": "Path on the Tree of Life"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Storage and verification metadata",
      "properties": {
        "ipfs_cid": {
          "type": "string",
          "description": "IPFS Content ID for this profile"
        },
        "verification_tx_hash": {
          "type": "string",
          "description": "Transaction hash for verification"
        },
        "lineage_root_tx_hash": {
          "type": "string",
          "description": "Transaction hash for the root of this profile's lineage"
        },
        "storage_proof_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to storage proof"
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Tags for categorizing this profile",
      "items": {
        "type": "string"
      }
    }
  }
}
